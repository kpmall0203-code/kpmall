/** 메뉴: 설명서 만들기 / 열기 */
function showManual() {
  var sh = ensureSheet_(SHEET_MANUAL, MANUAL_HEADER);
  sh.clear();

  var rows = manualRows_();
  sh.getRange(1, 1).setValue('사입도우미 설명서 — ' + ymd_(new Date()) + ' 기준')
    .setFontWeight('bold').setFontSize(13);
  sh.getRange(2, 1).setValue(
    '메뉴에 있는 순서 그대로입니다. [필요한 자료]가 없으면 그 기능을 눌렀을 때 ' +
    '무엇이 없는지 알려주고 그 자리에서 받아옵니다.').setFontSize(9);

  sh.getRange(3, 1, 1, MANUAL_HEADER.length).setValues([MANUAL_HEADER])
    .setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#ffffff');
  sh.getRange(4, 1, rows.length, MANUAL_HEADER.length).setValues(rows);

  // 구분선(▬)은 배경을 깔아 눈으로 끊어 읽게 한다
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][0]).indexOf('▬') === 0) {
      sh.getRange(4 + i, 1, 1, MANUAL_HEADER.length)
        .setFontWeight('bold').setBackground('#eceff1');
    }
  }

  sh.setFrozenRows(3);
  sh.setColumnWidth(1, 70);
  sh.setColumnWidth(2, 230);
  sh.setColumnWidth(3, 460);
  sh.setColumnWidth(4, 170);
  sh.setColumnWidth(5, 120);
  sh.setColumnWidth(6, 190);
  sh.getRange(4, 1, rows.length, MANUAL_HEADER.length).setWrap(true).setVerticalAlignment('top');

  showSheet_(SHEET_MANUAL);
  toast_('설명서 ' + rows.length + '줄');
  return SHEET_MANUAL;
}
